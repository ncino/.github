{
  "name": ".github",
  "private": true,
  "description": "GitHub Actions workflows for nCino development",
  "homepage": "https://github.com/ncino/.github",
  "repository": "git://github.com/ncino/.github.git",
  "release": {
    "branches": [
      "release",
      {
        "channel": "channel-${name}",
        "name": "next-major",
        "prerelease": true
      },
      {
        "channel": "channel-${name}",
        "name": "feature*",
        "prerelease": true
      },
      "+([0-9])?(.{+([0-9]),x}).x"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "parserOpts": {
            "noteKeywords": [
              "BREAKING CHANGE",
              "BREAKING CHANGES"
            ]
          },
          "preset": "angular"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "parserOpts": {
            "noteKeywords": [
              "BREAKING CHANGE",
              "BREAKING CHANGES"
            ]
          },
          "preset": "angular",
          "writerOpts": {
            "commitsSort": [
              "subject",
              "scope"
            ]
          }
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "workflow-templates/1gp-ci.yml",
              "label": "1GP CI"
            },
            {
              "path": "workflow-templates/1gp-publish.yml",
              "label": "JS distribution"
            }
          ]
        }
      ]
    ],
    "tagFormat": "${version}"
  },
  "devDependencies": {
    "semantic-release": "^24.2.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
